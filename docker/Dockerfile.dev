# The worker's Python minor version MUST match the client's (the serialize
# version handshake rejects mismatches). Override with
#   --build-arg PYTHON_VERSION=3.12
# to match a different local interpreter.
ARG PYTHON_VERSION=3.14
FROM python:${PYTHON_VERSION}-slim
WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY sk8s ./sk8s
# The s3 extra puts boto3 in the worker so s3:// stores work. Pass
#   --build-arg EXTRAS=s3,gcs
# for a worker that can also reach gs:// stores and artifact locations.
ARG EXTRAS=s3
RUN pip install --no-cache-dir ".[${EXTRAS}]"
